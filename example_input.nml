!rename this to input.nml and place in the input/output folder
&grid_params
    N = 70, 70, 30,
    box_size = 15., 15., 19.,
    !bottom_left_corner = [0., 0., 0.],
/
&system_params
    n_part = 15000,
    load_sys = .false.,
    load_fname = "",
    psi0_type = "double_gaussian",
/
&solver_params
    Euler_imag_dt = 1.25e11,
    steps_todo = 3,
/
&H_params
    V_ext_type = "double_well"
/


&double_gaussian_parameters
    sigma = 0.5 , 0.5 , 1.5,
    r01 = -1.5, 0., 0.,
    r02 =  1.5, 0., 0.,
/

&double_well_parameters
    d = 1.5,
/

