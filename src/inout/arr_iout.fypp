module arr_iout
    use :: typedef, only:wp
    use :: grid_util, only:grid_params
    use :: stdlib_io_npy, only:save_npy, load_npy

    implicit none
    private

    public :: write_arr
    public :: write_spacial
     
    interface write_arr
        #:for RANK in [1,2,3]
            #:for TYPE in ['real(wp)', 'complex(wp)']
                #:set TYPENAME = TYPE.split("(")[0]
                #:set PROCNAME = "write_arr_" + TYPENAME + "_" + str(RANK) + "d" 
                module procedure ${PROCNAME}$
            #:endfor
        #:endfor
    end interface

    interface write_spacial
    #:for TYPE in ['real(wp)', 'complex(wp)']
        #:set TYPENAME = TYPE.split("(")[0]
        #:set PROCNAME = "write_spacial_" + TYPENAME
        module procedure ${PROCNAME}$
    #:endfor
    end interface write_spacial
contains

    #:for RANK in [1,2,3]
        #:for TYPE in ['real(wp)', 'complex(wp)']
            #:set TYPENAME = TYPE.split("(")[0]
            #:set PROCNAME = "write_arr_" + TYPENAME + "_" + str(RANK) + "d" 

            subroutine ${PROCNAME}$(fname, arr)
                character(len=*), intent(in) :: fname
                ${TYPE}$, intent(in) :: arr(${(":,"*RANK)[:-1]}$)
                call save_npy(trim(fname)//".npy", arr)
            end subroutine ${PROCNAME}$ 
        #:endfor
    #:endfor

    #:for TYPE in ['real(wp)', 'complex(wp)']
        #:set TYPENAME = TYPE.split("(")[0]
        #:set PROCNAME = "write_spacial_" + TYPENAME
        subroutine ${PROCNAME}$(fname, arr, blc, dr)
            character(len=*), intent(in) :: fname
            ${TYPE}$, intent(in) :: arr(:,:,:)
            real(wp), intent(in) :: blc(3)
            real(wp), intent(in) :: dr(3)

            integer :: io

            real(wp) :: bottom_left_corner(3) = [0._wp, 0._wp, 0._wp]
            real(wp) :: cell_size(3) = [0._wp, 0._wp, 0._wp]


            namelist /spacial_params/ bottom_left_corner, cell_size      

            bottom_left_corner = blc
            cell_size = dr

            io = 67
            open(io, file=trim(fname)//".nml", action="write")
            write(io, nml=spacial_params)
            close(io)
            call save_npy(trim(fname)//".npy", arr)
        end subroutine ${PROCNAME}$ 
    #:endfor

end module arr_iout
