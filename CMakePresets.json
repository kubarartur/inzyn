{
  "version": 4,
  "configurePresets": [
    {
      "name": "Debug",
      "displayName": "default Preset",
      "description": "some default preset blah",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
          "NO_CONTACT": "OFF",
          "NO_DIPOLE": "OFF",
          "NO_OSCILLATOR": "OFF",
          "CMAKE_BUILD_TYPE": "Debug"
        }
    },
    {
      "name": "Release",
      "displayName": "default Preset",
      "description": "some default preset blah",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
          "NO_CONTACT": "ON",
          "NO_DIPOLE": "OFF",
          "NO_OSCILLATOR": "ON",
          "CMAKE_BUILD_TYPE": "Release"
        }
    }
  ]
}
