{
  "version": 4,
  "configurePresets": [
    {
      "name": "Debug",
      "displayName": "default Preset",
      "description": "some default preset blah",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
          "CMAKE_BUILD_TYPE": "Debug",
          "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "Release",
      "displayName": "default Preset",
      "description": "some default preset blah",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
          "CMAKE_BUILD_TYPE": "Release",
          "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "Rdeb",
      "displayName": "default Preset",
      "description": "some default preset blah",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
          "CMAKE_BUILD_TYPE": "RelWithDebInfo",
          "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "Euler",
      "displayName": "default Preset",
      "description": "some default preset blah",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
          "CMAKE_BUILD_TYPE": "Release",
          "BUILD_TESTING": "OFF",
          "CMAKE_Fortran_COMPILER": "ifort"
      }
    }
  ]
}
